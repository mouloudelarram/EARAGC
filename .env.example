# ================================
# Enterprise Architecture RAG Copilot
# Environment Configuration
# ================================

# --- Database ---
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=ragdb
DATABASE_URL=postgresql://raguser:ragpass@postgres:5432/ragdb

# --- Ollama (Local LLM) ---
OLLAMA_BASE_URL=http://ollama:11434
# Recommended local model currently installed and verified
OLLAMA_MODEL=llama3.1:latest

# --- Embedding Model (sentence-transformers) ---
# Runs locally on CPU — no API key required
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Reranker Model (CrossEncoder) ---
RERANKER_MODEL=BAAI/bge-reranker-base

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Hybrid Retrieval Weights ---
VECTOR_WEIGHT=0.6
BM25_WEIGHT=0.4

# --- Retrieval ---
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5

# --- Upload Limits ---
MAX_FILE_SIZE_MB=10

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

